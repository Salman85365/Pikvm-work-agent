# Named profiles. Names use letters, numbers, hyphens, or underscores.
# A hyphen in a profile name becomes an underscore in its variable prefix.
PIKVM_PROFILES=heidrick,lab-kvm
PIKVM_PROFILE=heidrick

# Heidrick PiKVM: server-side 2FA remains enabled and its seed lives only in Keychain.
PIKVM_HEIDRICK_URL=https://heidrick-pikvm.example.local/kvm
PIKVM_HEIDRICK_USERNAME=admin
PIKVM_HEIDRICK_PASSWORD=change-me
PIKVM_HEIDRICK_TOTP_REQUIRED=true
PIKVM_HEIDRICK_TOTP_PROVIDER=keychain
PIKVM_HEIDRICK_TOTP_KEYCHAIN_SERVICE=pikvm-work-agent.totp
PIKVM_HEIDRICK_TOTP_INTERACTIVE_FALLBACK=false
PIKVM_HEIDRICK_VERIFY_SSL=false

# Lab PiKVM: this device does not require 2FA, so no Keychain TOTP entry is consulted.
PIKVM_LAB_KVM_URL=https://lab-pikvm.example.local
PIKVM_LAB_KVM_USERNAME=admin
PIKVM_LAB_KVM_PASSWORD=change-me
PIKVM_LAB_KVM_TOTP_REQUIRED=false
PIKVM_LAB_KVM_VERIFY_SSL=false

# Optional per-profile network/HID overrides use the same prefix, for example:
# PIKVM_HEIDRICK_CONNECT_TIMEOUT=5
# PIKVM_HEIDRICK_REQUEST_TIMEOUT=15
# PIKVM_HEIDRICK_MAX_RETRIES=2
# PIKVM_HEIDRICK_RETRY_BACKOFF=0.25
# PIKVM_HEIDRICK_MOUSE_MOVE_SETTLE_SECONDS=0.1
# PIKVM_HEIDRICK_KEYMAP=en-us

# Legacy PIKVM_URL/USERNAME/PASSWORD variables remain supported when PIKVM_PROFILES and
# PIKVM_PROFILE are both absent.

# OpenAI screen analysis runs only on this Mac. Keep the real key in .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_SERVICE_TIER=default
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=auto
OPENAI_STORE=false
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_ESCALATION_ENABLED=false
OPENAI_CONFIDENCE_THRESHOLD=0.80

# Milestone 4 controller model routing. The vision-specific names override
# OPENAI_MODEL / OPENAI_SERVICE_TIER / OPENAI_REASONING_EFFORT when present.
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_SERVICE_TIER=default
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_PLANNER_SERVICE_TIER=default
OPENAI_PLANNER_REASONING_EFFORT=low
OPENAI_PLANNER_REQUEST_TIMEOUT_SECONDS=30
OPENAI_PLANNER_MAX_RETRIES=2

# Bounded controller and local screen-change behavior.
AGENT_MAX_STEPS=12
AGENT_MAX_RUNTIME_SECONDS=180
AGENT_MIN_ACTION_CONFIDENCE=0.80
AGENT_MAX_NO_CHANGE_STEPS=2
AGENT_MAX_REPEATED_ACTIONS=1
AGENT_SCREEN_POLL_INTERVAL_MS=300
AGENT_SCREEN_CHANGE_TIMEOUT_SECONDS=5
AGENT_SCREEN_STABLE_FRAMES=2
AGENT_SCREEN_STABLE_THRESHOLD=0.015
# Fraction of the 64x36 comparison grid that must move for a small popover (Slack's profile
# menu) to count as a change. The whole-screen mean above cannot see it.
AGENT_SCREEN_LOCALIZED_CHANGE_THRESHOLD=0.004
AGENT_STALE_SCREEN_THRESHOLD=0.06
