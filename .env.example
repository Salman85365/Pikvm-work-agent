# PiKVM's base URL. Do not include /api.
PIKVM_URL=https://pikvm.local
PIKVM_USERNAME=admin
PIKVM_PASSWORD=change-me

# Prompt for a fresh hidden six-digit code for every command.
PIKVM_TOTP_REQUIRED=true

# Keep this true when PiKVM has a trusted TLS certificate.
# The factory PiKVM certificate is self-signed, so local setups commonly need false.
PIKVM_VERIFY_SSL=false

# Network behavior for read-only requests such as screenshots.
PIKVM_CONNECT_TIMEOUT=5
PIKVM_REQUEST_TIMEOUT=15
PIKVM_MAX_RETRIES=2
PIKVM_RETRY_BACKOFF=0.25

# Used by the PiKVM text-print endpoint.
PIKVM_KEYMAP=en-us

# OpenAI screen analysis runs only on this Mac. Keep the real key in .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_SERVICE_TIER=default
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=auto
OPENAI_STORE=false
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_ESCALATION_ENABLED=false
OPENAI_CONFIDENCE_THRESHOLD=0.80

# Milestone 4 controller model routing. The vision-specific names override
# OPENAI_MODEL / OPENAI_SERVICE_TIER / OPENAI_REASONING_EFFORT when present.
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_SERVICE_TIER=default
OPENAI_VISION_REASONING_EFFORT=low
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_PLANNER_SERVICE_TIER=default
OPENAI_PLANNER_REASONING_EFFORT=low
OPENAI_PLANNER_REQUEST_TIMEOUT_SECONDS=30
OPENAI_PLANNER_MAX_RETRIES=2

# Bounded controller and local screen-change behavior.
AGENT_MAX_STEPS=12
AGENT_MAX_RUNTIME_SECONDS=180
AGENT_MIN_ACTION_CONFIDENCE=0.80
AGENT_MAX_NO_CHANGE_STEPS=2
AGENT_MAX_REPEATED_ACTIONS=1
AGENT_SCREEN_POLL_INTERVAL_MS=300
AGENT_SCREEN_CHANGE_TIMEOUT_SECONDS=5
AGENT_SCREEN_STABLE_FRAMES=2
AGENT_SCREEN_STABLE_THRESHOLD=0.015
AGENT_STALE_SCREEN_THRESHOLD=0.06
